#!/bin/bash
# ==============================================================================
# Conventional Commits validator
# Validates that commit messages follow the conventional commits format.
# ==============================================================================

COMMIT_MSG_FILE="$1"

if [[ ! -r "$COMMIT_MSG_FILE" ]]; then
    echo "ERROR: Cannot read the commit message file: $COMMIT_MSG_FILE" >&2
    exit 1
fi

IFS= read -r COMMIT_MSG < "$COMMIT_MSG_FILE" || true

PATTERN='^(feat|fix|docs|style|refactor|test|chore|ci|build|perf|revert)(\([a-z0-9]+(-[a-z0-9]+)*\))?!?: .{1,72}$'

if [[ ! "$COMMIT_MSG" =~ $PATTERN ]]; then
    echo "" >&2
    echo "ERROR: Commit message does not follow Conventional Commits." >&2
    echo "" >&2
    echo "Format: <type>(<optional-lowercase-scope>): <imperative subject>" >&2
    echo ""
    echo "Allowed types: feat, fix, docs, style, refactor, test, chore, ci, build, perf, revert" >&2
    echo "" >&2
    echo "  Examples:" >&2
    echo "    feat(queue): limit workers by processing stage" >&2
    echo "    fix(output): preserve completed files after cancellation" >&2
    echo "    feat(cli)!: replace legacy command-line options" >&2
    echo "" >&2
    echo "Got: $COMMIT_MSG" >&2
    echo ""
    exit 1
fi

exit 0
